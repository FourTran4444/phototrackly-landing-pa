# Production origin for canonical URLs, Open Graph, sitemap and origin validation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=G-0PSP21DKNJ

# Vercel: use Supabase. Run supabase/migrations/202609230001_early_access.sql first.
LEAD_STORAGE=supabase
SUPABASE_URL=
# Server-only secret key; NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported in place of SUPABASE_SECRET_KEY.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable: it signs removal links and hashes rate-limit identifiers.
LEAD_TOKEN_SECRET=

# Alternative for local development / a single-process self-hosted server only:
# LEAD_STORAGE=sqlite
# LEAD_DATA_DIRECTORY=/absolute/private/persistent/path
# A durable, backed-up disk is required. SQLite mode is refused on Vercel.
